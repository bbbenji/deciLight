{
    "configuration": "FlashFreq=80,UploadSpeed=921600,DebugLevel=none,EraseFlash=none",
    "board": "esp32:esp32:firebeetle32",
    "port": "/dev/ttyUSB0",
    "sketch": "deciLight.ino",
